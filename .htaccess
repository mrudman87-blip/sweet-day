# Настройки для хостинга на Apache (Beget, Timeweb, REG.RU …). На GitHub Pages не используются.

# 1. Запрет открывать config.php (там токен бота) из браузера
<Files "config.php">
  Require all denied
</Files>

# 2. Сжатие текстовых файлов: HTML, CSS, JS уходят в 3–5 раз меньше
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# 3. Кеш: браузер запоминает картинки и шрифты на год, CSS/JS — на неделю.
#    Повторный визит — сайт открывается мгновенно.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
